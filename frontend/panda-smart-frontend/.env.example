# Django REST API origin. Vite proxies /api to this server in development.
VITE_BACKEND_URL=http://localhost:8000
# Optional absolute API origin for deployments; leave blank to use same-origin/proxy.
VITE_API_BASE_URL=
# Set true only for local UI development before backend endpoints are ready.
# Mock fallback is never enabled by default.
VITE_USE_MOCKS=false
