# Copy to .env and adjust. Secrets must never be committed.
SECRET_KEY=dev-only-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Leave DATABASE_URL unset to use backend/db.sqlite3 on any machine.
# DATABASE_URL=postgresql://user:password@localhost:5432/pandasmart
# 5500 = the HTML frontend (frontend/html). 5173 = the React shell, if revived.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173
# Farmer verification links: FRONTEND_BASE_URL + FRONTEND_VERIFY_PATH + token
FRONTEND_BASE_URL=http://127.0.0.1:5500
FRONTEND_VERIFY_PATH=/verify.html?token=
# Cooperative name for self-registered farmers (blank = oldest cooperative)
SELF_REGISTER_TENANT=
VERIFY_TOKEN_TTL_DAYS=14
# Sign-in tokens expire after this many hours (168 = 7 days)
TOKEN_TTL_HOURS=168
LOGIN_PHONE_RATE=20/hour
# Required when DEBUG=0. Register https://<host>/api/v1/ussd/?key=<this> with Africa's Talking
USSD_CALLBACK_SECRET=
# Weather: NASA POWER rainfall is free; Open-Meteo forecasts are NON-COMMERCIAL only
RAINFALL_SOURCE_PRIORITY=NASA_POWER,CHIRPS
OPEN_METEO_ENABLED=0
AT_USERNAME=sandbox
AT_API_KEY=
